"MI_Asphalt": &"road",
"MI_Concrete": &"concrete",
"MI_FakeInterior*": &"hidden",
"MI_Glass": &"window",
"MI_Interior*": &"hidden",
"MI_RedBrick*": &"wall",
"MI_StreetDecals": &"paint",
"MI_Trim": &"trim",
"MI_Trim_Dark": &"trim_dark",
"MI_Trim_Green": &"trim",
"MI_Trim_MetalConcrete": &"trim"
})
