node_modules/
*.patch

/.claude/

# Local/editor state and generated caches
.idea/
.vscode/
.cache/
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# Godot generated import state
.godot/
*.import

# textures Godot extracts from the models on import; regenerated by importing again
/godot/models/*.png
# style-study renders; regenerated by running the study scene
/godot/studies/*/out/
# third-party game screenshots used as style reference; re-download from the URLs in 来源.txt
/docs/巴别塔圣歌-游戏实拍/*
!/docs/巴别塔圣歌-游戏实拍/来源.txt

/tasks.md

# Local project instructions
/AGENTS.md

# animal build outputs rewritten by every rerun (godot/modeling/animals/animal_tools/README.md)
/godot/modeling/animals/**/verify_report.json
/godot/modeling/animals/**/silhouette_report.json
/godot/modeling/animals/**/test_pose_matrices.json
/godot/modeling/animals/**/source_inventory.json
/godot/modeling/animals/**/frames/

# Real-place source data: downloads, re-fetched by the scripts listed in research/<site>/来源.md
research/*/imagery/
research/*/data/*.tif
research/*/data/*.osm
research/*/photos/*.jpg
research/*/photos/*.png
research/*/maps/
# drawn over the imagery, so it stays out like the imagery
research/*/road_slopes.png

# Local rollback copies; production models and builders are versioned separately.
/godot/modeling/review/window_sealing/originals.zip
/godot/modeling/review/window_sealing/before_roof_doors.zip

# Regenerable pose exports from motion reviews.
/delivery/**/poses/
/delivery/**/full_poses/
/delivery/**/*.bin
/delivery/**/*.f32
